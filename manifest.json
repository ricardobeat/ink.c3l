{
	"provides": "ink",
	"sources": [
		"src/*",
		"src/themes/**",
		"src/embedded/**"
	],
	"targets": {
		"macos-aarch64": {
			"cflags": "-mmacosx-version-min=12.0"
		},
		"macos-x64": {
			"cflags": "-mmacosx-version-min=12.0"
		},
		"linux-x64": {
			"linked-libraries": [
				"dl"
			]
		},
		"linux-aarch64": {
			"linked-libraries": [
				"dl"
			]
		}
	},
	"c-sources": [
		"vendor/tree-sitter/src/lib.c"
	],
	"c-include-dirs": [
		"vendor/tree-sitter/src",
		"vendor/tree-sitter/include"
	]
}
