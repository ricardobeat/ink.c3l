{
  "langrev": "1",
  "sources": [
    "src"
  ],
  "test-sources": [
    "src/test"
  ],
  "cflags": "-mmacosx-version-min=12.0",
  "c-sources": [
    "vendor/tree-sitter/src/lib.c"
  ],
  "c-include-dirs": [
    "vendor/tree-sitter/src",
    "vendor/tree-sitter/include"
  ],
  "targets": {
    "ink": {
      "type": "static-lib"
    },
    "render": {
      "type": "executable",
      "sources": [
        "src",
        "examples/render.c3"
      ]
    },
    "inkfmt": {
      "type": "executable",
      "sources": [
        "cli/inkfmt.c3"
      ]
    },
    "grammars": {
      "type": "executable",
      "sources": [
        "cli/grammars.c3"
      ]
    }
  }
}
